# The app's settings for `protobase dev`, `protobase serve` and the db:* scripts; a deployed app gets them from its host.
DATABASE_URL=postgres://protobase:protobase@localhost:55432/scratch

# Admin store (Better Auth users, sessions, signing keys): the `auth` schema of DATABASE_URL, created by `db:migrate`.
PROTOBASE_URL=http://localhost:5173
# Signs cookies and encrypts the token keys. Generate your own: openssl rand -base64 32
PROTOBASE_SECRET=change-me-generate-with-openssl-rand-base64-32
# PROTOBASE_TRUSTED_ORIGINS=

# Browser push of notifications, optional: `bun run protobase notifications vapid-keys` prints the two keys. Set all
# three or none; keep the private key out of the repository.
# PROTOBASE_VAPID_PUBLIC_KEY=
# PROTOBASE_VAPID_PRIVATE_KEY=
# PROTOBASE_VAPID_SUBJECT=mailto:you@example.com
